# Runtime generated XAML cache
**/Xaml_bin/

# Log files
*.log

# Runtime user data (ignore INI files in demos/)
demos/*.ini

# Backup / duplicate files
*.txt
*_backup.*

# Compiled executable (not tracked, provided as release ZIP)
WPF_Runner.exe

# Build artifacts (except the release ZIP)
release/*
!release/WPF_Runner.zip

# Screenshots and capture tools
screenshots/
*.exe

# OS files
Thumbs.db
.DS_Store
Desktop.ini
