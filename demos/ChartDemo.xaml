<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:AhkControls;assembly=WPF_Runner"
        Title="Chart Demo"
        Height="600" Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1C1C2E" Offset="0"/>
            <GradientStop Color="#0A1628" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#334466"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5588AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="StatusStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#88BBCC"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6" FlowDirection="LeftToRight">
            <TextBlock Text="WPF Chart" Foreground="#AACCEE" FontFamily="Consolas" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,16,0"/>
            <Button x:Name="BtnLoad" Content="Load Data" Style="{StaticResource BtnStyle}"/>
            <Button x:Name="BtnColumn" Content="Column" Style="{StaticResource BtnStyle}"/>
            <Button x:Name="BtnLine" Content="Line" Style="{StaticResource BtnStyle}"/>
            <Button x:Name="BtnPie" Content="Pie" Style="{StaticResource BtnStyle}"/>
            <Button x:Name="BtnBar" Content="Bar" Style="{StaticResource BtnStyle}"/>
            <Button x:Name="BtnArea" Content="Area" Style="{StaticResource BtnStyle}"/>
            <Separator Width="10" Opacity="0"/>
            <Button x:Name="BtnClose" Content="X" Style="{StaticResource BtnStyle}" Background="#993333"/>
        </StackPanel>
        <!-- Chart -->
        <ctrl:ChartControl Grid.Row="1" x:Name="Chart1" Margin="0,0,0,6"/>
        <!-- Status -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock x:Name="LblStatus" Text="Ready" Style="{StaticResource StatusStyle}"/>
        </StackPanel>
    </Grid>
</Window>
