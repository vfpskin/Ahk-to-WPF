<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerts Showcase"
        Width="500"
        Height="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Initial theme (Dark) -->
        <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Surface" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="Border" Color="#404040"/>
        <SolidColorBrush x:Key="Accent" Color="#5B9BD5"/>
        <SolidColorBrush x:Key="AccentHover" Color="#4A87C0"/>

        <!-- SweetAlert2 fixed colors -->
        <SolidColorBrush x:Key="ColorSuccess" Color="#A5DC86"/>
        <SolidColorBrush x:Key="ColorError" Color="#F27474"/>
        <SolidColorBrush x:Key="ColorWarning" Color="#F8BB86"/>
        <SolidColorBrush x:Key="ColorInfo" Color="#3FC3EE"/>

        <!-- Global Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Surface}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Danger}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- Sombra externa de la ventana principal -->
        <Border Margin="20" CornerRadius="15" Background="{DynamicResource Surface}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>

            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar strip -->
                <Border x:Name="TitleBar" Grid.Row="0" Height="40"
                        Background="Transparent"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblTitle" Text="Alert Showcase"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Button x:Name="BtnTheme" Width="70" Height="28" Content="Theme" FontSize="12" Padding="0" Margin="0,0,8,0"
                                    Background="{DynamicResource Surface2}" Foreground="{DynamicResource TextSecondary}"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}" Content="─" Visibility="Collapsed"/>
                            <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Content="□" Visibility="Collapsed"/>
                            <Button x:Name="BtnClose" Width="30" Height="30" Content="&#x2715;" FontSize="14" BorderThickness="0" Padding="0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Title -->
                <StackPanel Grid.Row="1" Margin="0,14,0,30" HorizontalAlignment="Center">
                    <TextBlock Text="Try the different types of MsgBox" Foreground="{DynamicResource TextSecondary}" FontSize="15" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Test Buttons -->
                <WrapPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                    
                    <Button x:Name="BtnAlertSuccess" Content="Success Alert" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background>
                            <SolidColorBrush Color="#A5DC86"/>
                        </Button.Background>
                    </Button>
                    
                    <Button x:Name="BtnAlertError" Content="Error Alert" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background>
                            <SolidColorBrush Color="#F27474"/>
                        </Button.Background>
                    </Button>
                    
                    <Button x:Name="BtnAlertWarning" Content="Warning Alert" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background>
                            <SolidColorBrush Color="#F8BB86"/>
                        </Button.Background>
                    </Button>
                    
                    <Button x:Name="BtnAlertInfo" Content="Info Alert" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background>
                            <SolidColorBrush Color="#3FC3EE"/>
                        </Button.Background>
                    </Button>

                    <Button x:Name="BtnInputBox" Content="Input Box" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background>
                            <SolidColorBrush Color="#87ADBD"/>
                        </Button.Background>
                    </Button>

                </WrapPanel>
            </Grid>
        </Border>

        <!-- SWEET ALERT OVERLAY -->
        <Grid x:Name="SweetAlertOverlay" Visibility="Collapsed" Background="#B2000000" Margin="20">
            <Border Margin="20" CornerRadius="12" Background="{DynamicResource Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="250" MaxWidth="400">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="5" Opacity="0.6"/>
                </Border.Effect>

                <StackPanel Margin="30">
                    <!-- Icons -->
                    <Grid x:Name="SA_IconContainer" Height="80" Margin="0,0,0,15" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Info Icon -->
                        <Grid x:Name="SA_IcoInfo" Visibility="Collapsed">
                            <Ellipse Width="60" Height="60" Stroke="{StaticResource ColorInfo}" StrokeThickness="3" Fill="Transparent"/>
                            <TextBlock Text="i" Foreground="{StaticResource ColorInfo}" FontSize="36" FontFamily="Arial" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Grid>
                        <!-- Success Icon -->
                        <Grid x:Name="SA_IcoSuccess" Visibility="Collapsed">
                            <Ellipse Width="60" Height="60" Stroke="{StaticResource ColorSuccess}" StrokeThickness="3" Fill="Transparent"/>
                            <Path Data="M 0,12 L 8,20 L 24,0" Width="24" Height="20" Stroke="{StaticResource ColorSuccess}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                        <!-- Error Icon -->
                        <Grid x:Name="SA_IcoError" Visibility="Collapsed">
                            <Ellipse Width="60" Height="60" Stroke="{StaticResource ColorError}" StrokeThickness="3" Fill="Transparent"/>
                            <Path Data="M 0,0 L 22,22 M 22,0 L 0,22" Width="22" Height="22" Stroke="{StaticResource ColorError}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Warning Icon -->
                        <Grid x:Name="SA_IcoWarning" Visibility="Collapsed">
                            <Ellipse Width="60" Height="60" Stroke="{StaticResource ColorWarning}" StrokeThickness="3" Fill="Transparent"/>
                            <TextBlock Text="!" Foreground="{StaticResource ColorWarning}" FontSize="36" FontFamily="Arial" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Grid>
                    </Grid>

                    <!-- Title -->
                    <TextBlock x:Name="SA_TxtTitle" Text="Title" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Message -->
                    <TextBlock x:Name="SA_TxtMessage" Text="Message" FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,25"/>

                    <!-- Buttons -->
                    <StackPanel x:Name="SA_PanelButtons" Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Simple style for these specific buttons so they don't inherit mismatched colors -->
                        <Button x:Name="BtnSA_OK" Content="OK" Foreground="White" BorderThickness="0" Padding="35,10" Margin="5" Visibility="Collapsed" MinWidth="100" MinHeight="40">
                            <Button.Background>
                                <SolidColorBrush Color="#7066E0"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- INPUT BOX OVERLAY -->
        <Grid x:Name="SweetInputOverlay" Visibility="Collapsed" Background="#B2000000" Margin="20">
            <Border Margin="20" CornerRadius="12" Background="{DynamicResource Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="300" MaxWidth="450">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="5" Opacity="0.6"/>
                </Border.Effect>

                <StackPanel Margin="30">
                    <!-- Question Icon -->
                    <Grid Height="80" Margin="0,0,0,15" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="60" Height="60" Stroke="#87ADBD" StrokeThickness="3" Fill="Transparent"/>
                        <TextBlock Text="?" Foreground="#87ADBD" FontSize="40" FontFamily="Arial" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Grid>

                    <!-- Title -->
                    <TextBlock x:Name="SI_TxtTitle" Text="Title" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Message -->
                    <TextBlock x:Name="SI_TxtMessage" Text="Message" FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- TextBox for Input -->
                    <TextBox x:Name="SI_InputText" Height="40" Margin="0,0,0,25" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnSI_OK" Content="OK" Foreground="White" BorderThickness="0" Padding="35,10" Margin="5" MinWidth="100" MinHeight="40">
                            <Button.Background>
                                <SolidColorBrush Color="#7066E0"/>
                            </Button.Background>
                        </Button>
                        <Button x:Name="BtnSI_Cancel" Content="Cancel" Foreground="White" BorderThickness="0" Padding="25,10" Margin="5" MinWidth="100" MinHeight="40">
                            <Button.Background>
                                <SolidColorBrush Color="#6E7881"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
