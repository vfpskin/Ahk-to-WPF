<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Animation Login"
        Width="380" Height="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border x:Name="MainCard" CornerRadius="16" Margin="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#004B8D"/>
                <GradientStop Offset="1" Color="#7B2D8E"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="6" Opacity="0.5"/>
        </Border.Effect>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <ColorAnimation
                            Storyboard.TargetProperty="Background.(GradientBrush.GradientStops)[0].Color"
                            To="#E8485B" Duration="0:0:3"/>
                        <ColorAnimation
                            Storyboard.TargetProperty="Background.(GradientBrush.GradientStops)[1].Color"
                            To="#F3A712" Duration="0:0:3"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Height="48"
                    Background="Transparent"
                    BorderBrush="#44FFFFFF"
                    BorderThickness="0,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblTitle" Text="Animation Login"
                               Foreground="White" FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="BtnClose" Content="&#x2715;" FontSize="16"
                                Width="34" Height="34" Padding="0"
                                Background="#55FFFFFF" Foreground="White"
                                BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="17"
                                            BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#99FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="32,48,32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Ellipse Grid.Row="0" Width="72" Height="72"
                         Fill="#44FFFFFF" HorizontalAlignment="Center" Margin="0,12,0,16">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                    </Ellipse.Effect>
                </Ellipse>

                <TextBlock Grid.Row="1" Text="Welcome Back"
                           Foreground="White" FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="2" Text="Please sign in to continue"
                           Foreground="#AAF0F0F0" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <StackPanel Grid.Row="3" VerticalAlignment="Top">
                    <TextBlock Text="USERNAME" Foreground="#CCFFFFFF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUser" Height="44" Margin="0,0,0,16"
                             Background="#33FFFFFF" Foreground="White"
                             BorderBrush="#44FFFFFF" BorderThickness="1"
                             Padding="14,0" FontSize="14"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="PASSWORD" Foreground="#CCFFFFFF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtPass" Height="44" Margin="0,0,0,24"
                                 Background="#33FFFFFF" Foreground="White"
                                 BorderBrush="#44FFFFFF" BorderThickness="1"
                                 Padding="14,0" FontSize="14"
                                 VerticalContentAlignment="Center"/>

                    <Button x:Name="BtnLogin" Content="LOGIN" Height="46"
                            Background="#CC000000" Foreground="White"
                            FontSize="15" FontWeight="Bold" BorderThickness="0">
                        <Button.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.4"/>
                        </Button.Effect>
                    </Button>

                    <TextBlock x:Name="TxtStatus" Text="" Foreground="#FF6B6B"
                               FontSize="13" HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2" Text="AHK - WPF Engine"
                       Foreground="#55FFFFFF" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,0,0,14"/>

            <!-- Welcome overlay (black bg, gradient rises from bottom revealing "Welcome") -->
            <Grid x:Name="WelcomeOverlay" Grid.RowSpan="3" Visibility="Collapsed">
                <Border CornerRadius="16" Background="#FF000000"/>
                <Border x:Name="RisingGradient" RenderTransformOrigin="0,1">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleY="0"/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, RelativeSource={RelativeSource AncestorType=Grid}}" Value="Visible">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                    From="0" To="1" Duration="0:0:0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#00E5FF"/>
                            <GradientStop Offset="1" Color="#FFD700"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="Welcome" Foreground="Black" FontSize="48"
                           FontWeight="Bold" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
