<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Support Analytics Dashboard" Height="780" Width="1180"
        Background="#05101E" WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="MainBg" Color="#05101E"/>
        <SolidColorBrush x:Key="CardBg" Color="#0D233A"/>
        <SolidColorBrush x:Key="CardBorder" Color="#132F4C"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#88A2BC"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#3FC972"/>
        <SolidColorBrush x:Key="AccentRed" Color="#F25F5F"/>
        <SolidColorBrush x:Key="TealBrush" Color="#49BCD3"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Inter"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <Style x:Key="DropdownStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Inter"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="HoverGlow" TargetType="Border">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="340"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOP ROW ==================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. NEW CONVERSATIONS CARD -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="NEW CONVERSATIONS" Style="{StaticResource HeaderTitleStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="BtnR1" Content="R" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                    Foreground="{StaticResource TextSecondary}" Background="#132F4C"
                                    BorderBrush="#1A3F5C" BorderThickness="1" Margin="0,0,4,0"
                                    ToolTipService.InitialShowDelay="0" ToolTip="Randomize"/>
                            <Button Name="BtnT1" Content="T" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                    Foreground="{StaticResource TextSecondary}" Background="#132F4C"
                                    BorderBrush="#1A3F5C" BorderThickness="1" Margin="0,0,4,0"
                                    ToolTipService.InitialShowDelay="0" ToolTip="Toggle trend"/>
                            <Button Name="BtnD1" Content="D" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                    Foreground="{StaticResource TextSecondary}" Background="#132F4C"
                                    BorderBrush="#1A3F5C" BorderThickness="1" Margin="0,0,4,0"
                                    ToolTipService.InitialShowDelay="0" ToolTip="Reset"/>
                            <TextBlock Text="Month to Date (May 1 - 9)" Style="{StaticResource DropdownStyle}" VerticalAlignment="Center"/>
                            <TextBlock Text=" ▾" Foreground="{StaticResource TextSecondary}" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,4" VerticalAlignment="Bottom">
                        <TextBlock Name="M1_Val" Text="377" Style="{StaticResource MetricValueStyle}"/>
                        <StackPanel Margin="16,0,0,6" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="M1_Arrow" Text="▼" Foreground="{StaticResource AccentRed}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Name="M1_Pct" Text="37%" Foreground="{StaticResource AccentRed}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Name="M1_Cmp" Text="Comparison period: 601" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Canvas Grid.Row="3" Margin="0,15,0,5" ClipToBounds="True">
                        <Polygon Points="20,95 20,70 63,77 105,66 148,48 190,59 233,52 275,70 318,73 360,57 360,95"
                                 Opacity="0.10">
                            <Polygon.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#49BCD3" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Polygon.Fill>
                        </Polygon>
                        <Polyline Points="20,70 60,65 100,50 140,78 180,60 220,55 260,82 300,75 340,35"
                                  Stroke="#4f6b88" StrokeThickness="1.5" StrokeDashArray="4 4"/>
                        <Polyline Points="20,70 63,77 105,66 148,48 190,59 233,52 275,70 318,73 360,57"
                                  Stroke="#49BCD3" StrokeThickness="2.5" ToolTip="Current period: trending"/>
                        <Ellipse Fill="#49BCD3" Width="4" Height="4" Canvas.Left="18" Canvas.Top="68" ToolTip="May 1: 160"/>
                        <Ellipse Fill="#49BCD3" Width="4" Height="4" Canvas.Left="61" Canvas.Top="75" ToolTip="May 2: 110"/>
                        <Ellipse Fill="#49BCD3" Width="4" Height="4" Canvas.Left="103" Canvas.Top="64" ToolTip="May 3: 200"/>
                        <Ellipse Fill="#49BCD3" Width="4" Height="4" Canvas.Left="146" Canvas.Top="46" ToolTip="May 4: 340"/>
                        <Ellipse Fill="#49BCD3" Width="4" Height="4" Canvas.Left="188" Canvas.Top="57" ToolTip="May 5: 250"/>
                        <Ellipse Fill="#49BCD3" Width="4" Height="4" Canvas.Left="231" Canvas.Top="50" ToolTip="May 6: 310"/>
                        <Ellipse Fill="#49BCD3" Width="4" Height="4" Canvas.Left="273" Canvas.Top="68" ToolTip="May 7: 160"/>
                        <Ellipse Fill="#49BCD3" Width="4" Height="4" Canvas.Left="316" Canvas.Top="71" ToolTip="May 8: 140"/>
                        <Ellipse Fill="#49BCD3" Width="4" Height="4" Canvas.Left="358" Canvas.Top="55" ToolTip="May 9: 270"/>
                    </Canvas>

                    <Grid Grid.Row="4" Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                        <UniformGrid Grid.Row="0" Columns="9" Margin="0,0,0,8">
                            <TextBlock Text="May 1" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="May 2" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="May 3" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="May 4" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="May 5" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="May 6" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="May 7" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="May 8" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="M.." FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        </UniformGrid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="12" Height="12" Fill="#49BCD3" RadiusX="2" RadiusY="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="New conversations" FontSize="11" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" Stroke="#88A2BC" StrokeDashArray="2 2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Compare period" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. NEW CONVERSATION VOLUME CARD -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="NEW CONVERSATION VOLUME" Style="{StaticResource HeaderTitleStyle}" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Month to Date (May 1 - 9)" Style="{StaticResource DropdownStyle}"/>
                            <TextBlock Text=" ▾" Foreground="{StaticResource TextSecondary}" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,24,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <UniformGrid Grid.Row="0" Columns="10" Margin="0,0,0,4">
                            <Border Style="{StaticResource HoverGlow}" Background="#49bcd3" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Bottom" ToolTip="Day 1: 245 conversations"/>
                            <Border Style="{StaticResource HoverGlow}" Background="#50a9cd" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Bottom" ToolTip="Day 2: 198 conversations"/>
                            <Border Style="{StaticResource HoverGlow}" Background="#508ec3" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Bottom" ToolTip="Day 3: 312 conversations"/>
                            <Border Style="{StaticResource HoverGlow}" Background="#5875b2" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Bottom" ToolTip="Day 4: 287 conversations"/>
                            <Border Style="{StaticResource HoverGlow}" Background="#6164a2" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Bottom" ToolTip="Day 5: 356 conversations"/>
                            <Border Style="{StaticResource HoverGlow}" Background="#8670ab" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Bottom" ToolTip="Day 6: 178 conversations"/>
                            <Border Style="{StaticResource HoverGlow}" Background="#a674ab" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Bottom" ToolTip="Day 7: 423 conversations"/>
                            <Border Style="{StaticResource HoverGlow}" Background="#c48bb9" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Bottom" ToolTip="Day 8: 267 conversations"/>
                            <Border Style="{StaticResource HoverGlow}" Background="#dceff1" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Bottom" ToolTip="Day 9: 189 conversations"/>
                            <Border Style="{StaticResource HoverGlow}" Background="#132f4c" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Bottom" Opacity="0.2" ToolTip="Day 10: forecast"/>
                        </UniformGrid>

                        <UniformGrid Grid.Row="1" Columns="10" Margin="0,4,0,0">
                            <Border BorderBrush="{StaticResource CardBorder}" Background="#061221" BorderThickness="1" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Top"/>
                            <Border BorderBrush="{StaticResource CardBorder}" Background="#061221" BorderThickness="1" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Top"/>
                            <Border BorderBrush="{StaticResource CardBorder}" Background="#061221" BorderThickness="1" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Top"/>
                            <Border BorderBrush="{StaticResource CardBorder}" Background="#061221" BorderThickness="1" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Top"/>
                            <Border BorderBrush="{StaticResource CardBorder}" Background="#061221" BorderThickness="1" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Top"/>
                            <Border BorderBrush="{StaticResource CardBorder}" Background="#061221" BorderThickness="1" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Top"/>
                            <Border BorderBrush="{StaticResource CardBorder}" Background="#061221" BorderThickness="1" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Top"/>
                            <Border BorderBrush="{StaticResource CardBorder}" Background="#061221" BorderThickness="1" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Top"/>
                            <Border BorderBrush="{StaticResource CardBorder}" Background="#061221" BorderThickness="1" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Top"/>
                            <Border BorderBrush="{StaticResource CardBorder}" Background="#061221" BorderThickness="1" CornerRadius="2" Margin="3" Height="70" VerticalAlignment="Top"/>
                        </UniformGrid>
                    </Grid>

                    <Grid Grid.Row="2" Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="5" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Margin="12,0" Height="4" VerticalAlignment="Center">
                            <Rectangle Fill="#132F4C" RadiusX="2" RadiusY="2"/>
                            <Rectangle Fill="#49BCD3" RadiusX="2" RadiusY="2" Width="120" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                            <Ellipse Fill="#FFFFFF" Stroke="#49BCD3" StrokeThickness="2" Width="10" Height="10" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                        </Grid>
                        <TextBlock Grid.Column="2" Text="82" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. OPEN CONVERSATIONS BY TEAMMATE CARD -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="OPEN CONVERSATIONS BY TEAMMATE" Style="{StaticResource HeaderTitleStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="BtnR5" Content="R" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                    Foreground="{StaticResource TextSecondary}" Background="#132F4C"
                                    BorderBrush="#1A3F5C" BorderThickness="1" Margin="0,0,4,0"
                                    ToolTipService.InitialShowDelay="0" ToolTip="Randomize"/>
                            <Button Name="BtnT5" Content="T" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                    Foreground="{StaticResource TextSecondary}" Background="#132F4C"
                                    BorderBrush="#1A3F5C" BorderThickness="1" Margin="0,0,4,0"
                                    ToolTipService.InitialShowDelay="0" ToolTip="Toggle"/>
                            <Button Name="BtnD5" Content="D" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                    Foreground="{StaticResource TextSecondary}" Background="#132F4C"
                                    BorderBrush="#1A3F5C" BorderThickness="1" Margin="0,0,4,0"
                                    ToolTipService.InitialShowDelay="0" ToolTip="Reset"/>
                            <TextBlock Text="Today (May 9)" Style="{StaticResource DropdownStyle}" VerticalAlignment="Center"/>
                            <TextBlock Text=" ▾" Foreground="{StaticResource TextSecondary}" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="210" Height="210" ToolTip="Team: 307 open conversations">
                            <Ellipse Stroke="#132F4C" StrokeThickness="16" Width="194" Height="194"/>
                            <Ellipse Name="D1_S1" Stroke="#49BCD3" StrokeThickness="16" StrokeDashArray="8.7 26.3" Width="194" Height="194" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Name="D1_S2" Stroke="#3FC972" StrokeThickness="16" StrokeDashArray="5.2 29.8" Width="194" Height="194" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Name="D1_S3" Stroke="#C48BB9" StrokeThickness="16" StrokeDashArray="4.2 30.8" Width="194" Height="194" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="144"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Name="D1_S4" Stroke="#6164A2" StrokeThickness="16" StrokeDashArray="16.8 18.2" Width="194" Height="194" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="187"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock Name="D1_Total" Text="307" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-10,0,0"/>
                            <TextBlock Text="TOTAL" Foreground="{StaticResource TextSecondary}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28,0,0"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Fill="#3fc972" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tijuana Milasevic" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="10"/>
                                    <TextBlock Name="D1_P1" Text="8.1%" Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Fill="#49bcd3" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Anup Nair" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="10"/>
                                    <TextBlock Name="D1_P2" Text="6.5%" Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Fill="#c48bb9" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Emese Vojter" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="10"/>
                                    <TextBlock Name="D1_P3" Text="5.5%" Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Fill="#6164a2" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ilyas Khan" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="10"/>
                                    <TextBlock Name="D1_P4" Text="5.2%" Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Name="D1_Other" Text="Other (+60%)" FontSize="9" Margin="14,4,0,0" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== BOTTOM ROW ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.95*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="CONVERSATIONS" Style="{StaticResource HeaderTitleStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Name="BtnR2" Content="R" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}" Background="#132F4C"
                                        BorderBrush="#1A3F5C" BorderThickness="1" Margin="0,0,4,0"
                                        ToolTipService.InitialShowDelay="0" ToolTip="Randomize"/>
                                <Button Name="BtnT2" Content="T" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}" Background="#132F4C"
                                        BorderBrush="#1A3F5C" BorderThickness="1" Margin="0,0,4,0"
                                        ToolTipService.InitialShowDelay="0" ToolTip="Toggle"/>
                                <Button Name="BtnD2" Content="D" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}" Background="#132F4C"
                                        BorderBrush="#1A3F5C" BorderThickness="1" Margin="0,0,4,0"
                                        ToolTipService.InitialShowDelay="0" ToolTip="Reset"/>
                                <TextBlock Text="Month to Date (May 1 - 9)" Style="{StaticResource DropdownStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text=" ▾" Foreground="{StaticResource TextSecondary}" FontSize="9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Name="M2_Val" Text="64.276" Style="{StaticResource MetricValueStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Background="#16352F" Margin="0,0,8,0">
                                    <TextBlock Name="M2_Arrow" Text="▲" Margin="6,2,3,2" Foreground="{StaticResource AccentGreen}" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Name="M2_Pct" Text="2%" Margin="0,2,6,2" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Name="M2_Cmp" Text="Comparison period: 62.737" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="LEADS" Style="{StaticResource HeaderTitleStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Name="BtnR3" Content="R" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}" Background="#132F4C"
                                        BorderBrush="#1A3F5C" BorderThickness="1" Margin="0,0,4,0"
                                        ToolTipService.InitialShowDelay="0" ToolTip="Randomize"/>
                                <Button Name="BtnT3" Content="T" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}" Background="#132F4C"
                                        BorderBrush="#1A3F5C" BorderThickness="1" Margin="0,0,4,0"
                                        ToolTipService.InitialShowDelay="0" ToolTip="Toggle"/>
                                <Button Name="BtnD3" Content="D" Width="22" Height="22" FontSize="10" FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}" Background="#132F4C"
                                        BorderBrush="#1A3F5C" BorderThickness="1" Margin="0,0,4,0"
                                        ToolTipService.InitialShowDelay="0" ToolTip="Reset"/>
                                <TextBlock Text="Month to Date (May 1 - 9)" Style="{StaticResource DropdownStyle}" VerticalAlignment="Center"/>
