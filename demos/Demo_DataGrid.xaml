<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Management System"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg"      Color="#0A0F1D"/>
        <SolidColorBrush x:Key="SidebarBg"     Color="#0E1527"/>
        <SolidColorBrush x:Key="Surface"       Color="#121B32"/>
        <SolidColorBrush x:Key="Surface2"      Color="#1A2646"/>
        <SolidColorBrush x:Key="Border"        Color="#25355F"/>
        <SolidColorBrush x:Key="Accent"        Color="#10B981"/>
        <SolidColorBrush x:Key="AccentHover"   Color="#059669"/>
        <SolidColorBrush x:Key="AccentGlow"    Color="#34D399"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#6B7280"/>
        <SolidColorBrush x:Key="Danger"        Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerHover"   Color="#DC2626"/>
        <SolidColorBrush x:Key="Success"       Color="#10B981"/>
        <SolidColorBrush x:Key="SuccessHover"  Color="#059669"/>
        <SolidColorBrush x:Key="RowHover"      Color="#1B2A4A"/>
        <SolidColorBrush x:Key="ScrollThumb"   Color="#25355F"/>

        <SolidColorBrush x:Key="ColorSuccess" Color="#A5DC86"/>
        <SolidColorBrush x:Key="ColorError"   Color="#F27474"/>
        <SolidColorBrush x:Key="ColorWarning" Color="#F8BB86"/>
        <SolidColorBrush x:Key="ColorInfo"    Color="#3FC3EE"/>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="CaretBrush"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="18,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Danger}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarThemeButton" TargetType="Button">
            <Setter Property="MinWidth"        Value="52"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Background"      Value="{DynamicResource Surface2}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGlow}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="0,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="40" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblTitle" Text="DataGrid Inventory Management Dashboard"
                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button x:Name="BtnTheme" Style="{StaticResource TitleBarThemeButton}" Content="Navy" Visibility="Collapsed"/>
                        <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}" Content="─" Visibility="Collapsed"/>
                        <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Content="□" Visibility="Collapsed"/>
                        <Button x:Name="BtnClose" Style="{StaticResource TitleBarButton}" Content="✕"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PRODUCT NAME" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="CATEGORY" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" Margin="10,0,0,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="STOCK" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" Margin="10,0,0,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="PRICE" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" Margin="10,0,0,0"/>

                        <TextBox x:Name="TxtName" Grid.Row="2" Grid.Column="0" Height="38" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtCategory" Grid.Row="2" Grid.Column="1" Height="38" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtStock" Grid.Row="2" Grid.Column="2" Height="38" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtPrice" Grid.Row="2" Grid.Column="3" Height="38" Margin="0,0,10,0"/>
                        
                        <Button x:Name="BtnSave" Grid.Row="2" Grid.Column="4" Content="+ Save Product" Height="38" Padding="20,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <DataGrid x:Name="GridInventory" AutoGenerateColumns="False" Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2.5*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.8*"/>
                            <DataGridTextColumn Header="Stock Level" Binding="{Binding Stock}" Width="1.2*"/>
                            <DataGridTextColumn Header="Unit Price ($)" Binding="{Binding Price}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblMetrics" Text="0 total items cataloged" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnSample" Content="+ Load Sample" Height="34" Padding="16,0" Margin="0,0,10,0" Background="{DynamicResource Accent}"/>
                            <Button x:Name="BtnModify" Height="34" Padding="16,0" Margin="0,0,10,0" Background="{DynamicResource Success}" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,12 L2,16 L6,16 L14,8 C15,7 16,6 15,5 L13,3 C12,2 11,2 10,3 Z" Fill="White" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text=" Modify Item" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDelete" Height="34" Padding="16,0" Background="{DynamicResource Danger}" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,2 L14,14 M14,2 L2,14" Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text=" Delete Item" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <Grid x:Name="SweetAlertOverlay" Visibility="Collapsed" Background="#D4000000">
            <Border Margin="30" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="300" MaxWidth="440">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="5" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel Margin="30">
                    <Grid x:Name="SA_IconContainer" Height="80" Margin="0,0,0,15" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="SA_IcoInfo" Visibility="Collapsed">
                            <Ellipse Width="60" Height="60" Stroke="{StaticResource ColorInfo}" StrokeThickness="3" Fill="Transparent"/>
                            <TextBlock Text="i" Foreground="{StaticResource ColorInfo}" FontSize="36" FontFamily="Arial" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Grid>
                        <Grid x:Name="SA_IcoSuccess" Visibility="Collapsed">
                            <Ellipse Width="60" Height="60" Stroke="{StaticResource ColorSuccess}" StrokeThickness="3" Fill="Transparent"/>
                            <Path Data="M 0,12 L 8,20 L 24,0" Width="24" Height="20" Stroke="{StaticResource ColorSuccess}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                        <Grid x:Name="SA_IcoError" Visibility="Collapsed">
                            <Ellipse Width="60" Height="60" Stroke="{StaticResource ColorError}" StrokeThickness="3" Fill="Transparent"/>
                            <Path Data="M 0,0 L 22,22 M 22,0 L 0,22" Width="22" Height="22" Stroke="{StaticResource ColorError}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="SA_IcoWarning" Visibility="Collapsed">
                            <Ellipse Width="60" Height="60" Stroke="{StaticResource ColorWarning}" StrokeThickness="3" Fill="Transparent"/>
                            <TextBlock Text="!" Foreground="{StaticResource ColorWarning}" FontSize="36" FontFamily="Arial" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="SA_TxtTitle" Text="Notification Title" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="SA_TxtMessage" Text="Detailed description message goes here." FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,25"/>

                    <StackPanel x:Name="SA_PanelButtons" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnSA_OK" Content="OK" Foreground="White" Padding="35,10" Margin="5" Visibility="Collapsed" MinWidth="100" MinHeight="40" Background="{DynamicResource Accent}"/>
                        <Button x:Name="BtnSA_Yes" Content="Yes" Foreground="White" Padding="30,10" Margin="5" Visibility="Collapsed" MinWidth="100" MinHeight="40" Background="{DynamicResource Danger}"/>
                        <Button x:Name="BtnSA_No" Content="No" Foreground="White" Padding="30,10" Margin="5" Visibility="Collapsed" MinWidth="100" MinHeight="40" Background="{DynamicResource Surface2}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>