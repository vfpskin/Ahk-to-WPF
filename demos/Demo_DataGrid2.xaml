<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataGrid Operations Demo" Width="1150" Height="780"
        WindowStartupLocation="CenterScreen"
        Background="#05101E"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="MainBg" Color="#05101E"/>
        <SolidColorBrush x:Key="CardBg" Color="#0D233A"/>
        <SolidColorBrush x:Key="CardBorder" Color="#132F4C"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#88A2BC"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#3FC972"/>
        <SolidColorBrush x:Key="AccentRed" Color="#F25F5F"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#49BCD3"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#EF8A62"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#F8BB86"/>

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#132F4C"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#1A3F5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A3F5C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#25355F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBtnGreen" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#1A3F2A"/>
            <Setter Property="BorderBrush" Value="#2A5F3A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A5F3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolBtnRed" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#4A1A1A"/>
            <Setter Property="BorderBrush" Value="#6B2A2A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6B2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ColBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#1A2A3F"/>
            <Setter Property="BorderBrush" Value="#2A3F5F"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="TextBox" x:Key="FilterBox">
            <Setter Property="Background" Value="#0A1525"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#0A1525"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#13203A"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#13203A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                CornerRadius="6" Padding="10">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Load:" Foreground="{StaticResource TextSecondary}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Name="Btn100" Content="100" Style="{StaticResource ToolBtn}"
                            ToolTipService.InitialShowDelay="0" ToolTip="Add 100 records individually"/>
                    <Button Name="Btn200" Content="200" Style="{StaticResource ToolBtn}"
                            ToolTipService.InitialShowDelay="0" ToolTip="Add 200 records individually"/>
                    <Button Name="Btn500" Content="500" Style="{StaticResource ToolBtn}"
                            ToolTipService.InitialShowDelay="0" ToolTip="Add 500 records individually"/>
                    <Button Name="Btn1000" Content="1000" Style="{StaticResource ToolBtn}"
                            ToolTipService.InitialShowDelay="0" ToolTip="Add 1000 records individually"/>

                    <Button Name="BtnBatch500" Content="Batch 500" Style="{StaticResource ToolBtn}"
                            Background="#1A3A2A" BorderBrush="#2A5A3A"
                            ToolTipService.InitialShowDelay="0" ToolTip="Add 500 records in a single batch message"/>

                    <Rectangle Width="1" Fill="{StaticResource CardBorder}" Margin="6,2" VerticalAlignment="Stretch"/>

                    <Button Name="BtnClear" Content="Clear All" Style="{StaticResource ToolBtnRed}"
                            ToolTipService.InitialShowDelay="0" ToolTip="Clear all records"/>
                    <Button Name="BtnDelSel" Content="Delete Sel" Style="{StaticResource ToolBtnRed}"
                            ToolTipService.InitialShowDelay="0" ToolTip="Delete selected row"/>
                    <Button Name="BtnDelRnd" Content="Delete Rnd" Style="{StaticResource ToolBtnRed}"
                            ToolTipService.InitialShowDelay="0" ToolTip="Delete a random row"/>
                </WrapPanel>

                <WrapPanel>
                    <Button Name="BtnColorRnd" Content="Random Rows" Style="{StaticResource ToolBtnGreen}"
                            ToolTipService.InitialShowDelay="0" ToolTip="Color each row with a random background"/>
                    <Button Name="BtnColorVal" Content="By Value" Style="{StaticResource ToolBtnGreen}"
                            ToolTipService.InitialShowDelay="0" ToolTip="Color cells conditionally (salary high/low, status)"/>
                    <Button Name="BtnColorCol" Content="Column Colors" Style="{StaticResource ToolBtnGreen}"
                            ToolTipService.InitialShowDelay="0" ToolTip="Color entire columns with distinct tints"/>
                    <Button Name="BtnClearCol" Content="Clear Colors" Style="{StaticResource ToolBtn}"
                            ToolTipService.InitialShowDelay="0" ToolTip="Remove all cell coloring"/>

                    <Rectangle Width="1" Fill="{StaticResource CardBorder}" Margin="6,2" VerticalAlignment="Stretch"/>

                    <TextBlock Text="Filter:" Foreground="{StaticResource TextSecondary}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Name="TxtFilter" Width="150" Height="22" Style="{StaticResource FilterBox}"
                             ToolTipService.InitialShowDelay="0" ToolTip="Type to filter by any column"/>
                    <Button Name="BtnFilter" Content="Go" Style="{StaticResource ToolBtn}" Padding="8,2"
                            ToolTipService.InitialShowDelay="0" ToolTip="Apply filter"/>
                    <Button Name="BtnClearFilter" Content="X" Style="{StaticResource ToolBtnRed}" Padding="6,2"
                            ToolTipService.InitialShowDelay="0" ToolTip="Clear filter"/>

                    <Rectangle Width="1" Fill="{StaticResource CardBorder}" Margin="6,2" VerticalAlignment="Stretch"/>

                    <TextBlock Text="Toggle Col:" Foreground="{StaticResource TextSecondary}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button Name="BtnColID" Content="ID" Style="{StaticResource ColBtn}"/>
                    <Button Name="BtnColName" Content="Name" Style="{StaticResource ColBtn}"/>
                    <Button Name="BtnColEmail" Content="Email" Style="{StaticResource ColBtn}"/>
                    <Button Name="BtnColDept" Content="Dept" Style="{StaticResource ColBtn}"/>
                    <Button Name="BtnColSalary" Content="Salary" Style="{StaticResource ColBtn}"/>
                    <Button Name="BtnColCity" Content="City" Style="{StaticResource ColBtn}"/>
                    <Button Name="BtnColStatus" Content="Status" Style="{StaticResource ColBtn}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                CornerRadius="6" ClipToBounds="True">
            <DataGrid x:Name="GridData" AutoGenerateColumns="False" Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                    <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="130"/>
                    <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" Width="100"/>
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="130"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                CornerRadius="6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="LblRecords" Text="Records: 0"
                           Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Name="LblSelected" Text="Selected: -"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Name="LblStatus" Text="Ready"
                           Foreground="{StaticResource AccentGreen}" FontSize="12" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
