<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modern Login"
        Width="400"
        Height="610"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444455"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444455"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#00A3FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#B8E6FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1AB2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Danger}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

<!-- ##############################       GUI      ######################################################################## -->
    <Grid>
        <!-- Outer window shadow -->
        <Border Margin="20" CornerRadius="15">
         <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <!-- Blue with full opacity -->
                <GradientStop Color="#FF045A8C" Offset="0"/>
                <!-- Light blue with full opacity -->
                <GradientStop Color="#FF20A3EE" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>

            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar strip -->
                <Border x:Name="TitleBar" Grid.Row="0" Height="40"
                        Background="Transparent"
                        BorderBrush="#60FFFFFF"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblTitle" Text="Welcome Back"
                                   Foreground="White"
                                   VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}" Content="─" Visibility="Collapsed"/>
                            <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Content="□" Visibility="Collapsed"/>
                            <Button x:Name="BtnClose" Width="30" Height="30" Content="&#x2715;" FontSize="14" Foreground="#F7E3FF" BorderThickness="0" Padding="0">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF1AB2FF" Offset="0"/>
                                        <GradientStop Color="#FF650D89" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Title -->
                <StackPanel Grid.Row="1" Margin="0,14,0,22" HorizontalAlignment="Center">
                    
                    
                   <Grid Width="70" Height="70" Margin="0,0,0,14">
                          <!-- Background ellipse -->
                          <Ellipse Fill="#007ACC">
                              <Ellipse.Effect>
                                  <DropShadowEffect Color="#007ACC"
                                                    BlurRadius="15"
                                                    ShadowDepth="0"
                                                    Opacity="0.5"/>
                              </Ellipse.Effect>
                          </Ellipse>

                          <!-- White PNG icon using OpacityMask -->
                          <Rectangle Width="32" Height="32"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="White">
                              <Rectangle.OpacityMask>
                                  <ImageBrush ImageSource="D:/MOLINA PABLO/PROYECTOS/AKH_WPF/Assets/login.png"/>
                              </Rectangle.OpacityMask>
                          </Rectangle>
                   </Grid>

                      
                    <TextBlock Text="Please login to your account" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Form -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="USERNAME" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtUser" Height="40" Margin="0,0,0,20"/>

                    <TextBlock Text="PASSWORD" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtPass" Height="40" Margin="0,0,0,10"/>

                    <TextBlock Text="Forgot Password?" Foreground="#B7E1FF" FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,18" Cursor="Hand"/>
                    
                     
                    <Button x:Name="BtnLogin" Content="LOGIN" Height="45" Margin="0,0,0,0" BorderThickness="2">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <!-- Deep blue -->
                                <GradientStop Color="#FF650D89" Offset="0"/>
                                <!-- Lighter cyan -->
                                <GradientStop Color="#FF1AB2FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                          <Button.BorderBrush>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                              <GradientStop Color="#FFA417DF" Offset="0"/>
                              <GradientStop Color="#FF0690D8" Offset="1"/>
                          </LinearGradientBrush>
                      </Button.BorderBrush>
                    </Button>
                    
                </StackPanel>

                <!-- Status message at bottom -->
                <TextBlock x:Name="TxtStatus" Grid.Row="3" Text="" Foreground="#FF4D4D" FontSize="13" HorizontalAlignment="Center" Margin="0,20,0,0" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
