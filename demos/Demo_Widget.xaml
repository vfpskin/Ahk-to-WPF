<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Widget"
        Width="250"
        Height="150"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="300" Top="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#333344"/>
            <Setter Property="Foreground" Value="#00E676"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Border x:Name="PART_Track" CornerRadius="5"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="5" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Use TitleBar as magic name so C# allows dragging from here -->
    <Border x:Name="TitleBar" Background="#1E1E28" CornerRadius="12" BorderBrush="#333344" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.4"/>
        </Border.Effect>
        
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="LblTitle" Text="SYSTEM MONITOR" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnMinimize" Width="20" Height="20" Background="Transparent" Content="─" FontSize="10" Foreground="#888" BorderThickness="0" Visibility="Collapsed"/>
                    <Button x:Name="BtnMaximize" Width="20" Height="20" Background="Transparent" Content="□" FontSize="10" Foreground="#888" BorderThickness="0" Visibility="Collapsed"/>
                    <Button x:Name="BtnClose" Width="20" Height="20" Background="Transparent" Content="&#x2715;" FontSize="10" Foreground="#888" BorderThickness="0" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Barras -->
            <StackPanel Grid.Row="1">
                <Grid Margin="0,0,0,5">
                    <TextBlock Text="CPU" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtCPU" Text="0%" Foreground="#00E676" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="ProgCPU" Value="0" Maximum="100" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,5">
                    <TextBlock Text="RAM" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtRAM" Text="0%" Foreground="#29B6F6" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="ProgRAM" Value="0" Maximum="100" Foreground="#29B6F6"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
