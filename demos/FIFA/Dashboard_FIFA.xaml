<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FIFA World Cup 2026 | Dashboard"
        Width="1300"
        Height="700"
        MinWidth="1180"
        MinHeight="690"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Padding="0,1,0,0"
        Background="{DynamicResource SidebarBg}">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#15121B"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#211E27"/>
        <SolidColorBrush x:Key="Surface" Color="#2C2832"/>
        <SolidColorBrush x:Key="Surface2" Color="#37333D"/>
        <SolidColorBrush x:Key="Surface3" Color="#1D1A23"/>
        <SolidColorBrush x:Key="Border" Color="#494454"/>
        <SolidColorBrush x:Key="Accent" Color="#13FF43"/>
        <SolidColorBrush x:Key="Accent2" Color="#E9C400"/>
        <SolidColorBrush x:Key="Accent3" Color="#D0BCFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E7E0ED"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CBC3D7"/>
        <SolidColorBrush x:Key="TextMuted" Color="#948EA0"/>

        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1622" Offset="0"/>
            <GradientStop Color="#0F0D15" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C2832"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopAction" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="#15121B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="{DynamicResource HeroGradient}"/>
        </Style>

        <Style x:Key="GlassCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="#231F2B"/>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- System border cover -->
        <Rectangle DockPanel.Dock="Top" Height="2" Fill="{DynamicResource SidebarBg}"/>
        
        <!-- Custom Titlebar -->
        <Border x:Name="TitleBar"
                DockPanel.Dock="Top" 
                Height="40"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="LblTitle"
                           Grid.Column="0"
                           Text="FIFA 2026 Dashboard"
                           Foreground="{DynamicResource TextPrimary}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="BtnMinimize" Width="40" Height="40" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" Content="&#x2014;" FontSize="18"/>
                    <Button x:Name="BtnMaximize" Width="40" Height="40" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" Content="&#x25A0;" FontSize="14"/>
                    <Button x:Name="BtnClose" Width="40" Height="40" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" Content="&#x2715;" FontSize="16"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBg}">
            <DockPanel LastChildFill="True" Margin="18">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Border Width="54" Height="54" CornerRadius="14" Background="{DynamicResource Surface2}" Margin="0,0,0,12" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                        <Image Source="Assets/logo_2026.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock x:Name="TxtFifa2026Title"
                               Text="FIFA 2026"
                               FontSize="24"
                               FontWeight="Black"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,2,0,2"/>
                    <TextBlock Text="USA | CANADA | MEXICO"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="NavHome" Style="{StaticResource NavButton}" Content="Dashboard"/>
                    <Button x:Name="NavCountries" Style="{StaticResource NavButton}" Content="Countries"/>
                    <Button x:Name="NavGroups" Style="{StaticResource NavButton}" Content="Groups"/>
                    <Button x:Name="NavFixture" Style="{StaticResource NavButton}" Content="Fixture"/>
                    <Button x:Name="NavStats" Style="{StaticResource NavButton}" Content="Standings"/>
                    <Button x:Name="NavStadiums" Style="{StaticResource NavButton}" Content="Venues"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Demo status"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12"/>
                        <TextBlock x:Name="TxtLastUpdate"
                                   Text="Ready"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,8"/>
                        <Button x:Name="BtnTheme" Style="{StaticResource TopAction}" Content="Change theme"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid x:Name="MainContent" Grid.Column="1" Background="{DynamicResource WindowBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSectionTitle"
                                   Text="Dashboard"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="TxtSectionDesc"
                                   Text="Tournament overview"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnRefresh" Style="{StaticResource TopAction}" Content="Refresh" Margin="0,0,12,0"/>
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Tournament starts" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                    <TextBlock Text="11 Jun 2026" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Countdown" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                    <TextBlock x:Name="TxtCountdown" Text="..." Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Home -->
                    <Grid x:Name="PageHome" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="0.85*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource HeroCard}" Margin="0,0,16,0" Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="0.85*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="WE ARE" FontSize="48" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="2026" FontSize="72" FontWeight="Black" Foreground="{DynamicResource Accent}" Margin="0,-8,0,12"/>
                                        <TextBlock Text="Witness the historic expansion to 48 teams across three nations. Track your favorite nations, venues and fixture updates from one place."
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="18"
                                                   TextWrapping="Wrap"
                                                   Width="520"
                                                   Margin="0,0,0,20"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnGetTicketsHome" Style="{StaticResource TopAction}" Content="Get Tickets" Padding="24,12" Margin="0,0,16,0"/>
                                            <Button x:Name="BtnFullScheduleHome" Background="Transparent" Foreground="{DynamicResource Accent2}" BorderBrush="{DynamicResource Accent2}" BorderThickness="2" Padding="24,12" Content="Full Schedule"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="290" Height="290" Fill="#2A2532" Opacity="0.75"/>
                                        <Border Width="240" Height="240" CornerRadius="120" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent2}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                            <Image Source="Assets/hero_dashboard.png" Stretch="UniformToFill"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Featured updates"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="12" Margin="0,12,0,10">
                                        <StackPanel>
                                            <TextBlock Text="&#x2022; Initial fixture load completed."
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="â€¢ Theme switching and navigation are live."
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock Text="â€¢ Demo is ready to present the concept."
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Next highlighted matches"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="12"/>
                                            <TextBlock x:Name="TxtNextMatch"
                                                       Text="Brazil vs Mexico"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Margin="0,6,0,0"/>
                                            <TextBlock x:Name="TxtNextMatchMeta"
                                                       Text="Group A | MetLife Stadium | 19:00"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,4,0,0"/>
                                            <Border Background="{DynamicResource Surface3}" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Last result loaded" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                                    <TextBlock x:Name="TxtLastResult"
                                                               Text="Spain 2 - 1 France"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               FontSize="20"
                                                               FontWeight="SemiBold"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource Surface3}" CornerRadius="10" Padding="0" Margin="0,12,0,0" Height="120" ClipToBounds="True">
                                                <Image Source="Assets/match_schedule.png" Stretch="UniformToFill"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <UniformGrid Grid.Row="2" Columns="4">
                            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="Teams" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="TxtTeamsValue" Text="48" Foreground="{DynamicResource TextPrimary}" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                    <TextBlock Text="Confirmed participants" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="Venues" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="TxtStadiumsValue" Text="16" Foreground="{DynamicResource TextPrimary}" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                    <TextBlock Text="Tournament stadiums" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="Matches" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="TxtMatchesValue" Text="0" Foreground="{DynamicResource TextPrimary}" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                    <TextBlock Text="Loaded fixture" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Goals" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="TxtGoalsValue" Text="0" Foreground="{DynamicResource TextPrimary}" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                    <TextBlock Text="Scored so far" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="Participating Nations"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                <UniformGrid Columns="6" Margin="0,16,0,0">
                                    <Border Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="14" Padding="14" Margin="0,0,12,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,0,10" ClipToBounds="True">
                                                <Image Source="Assets/logo_2026.png" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="HOST NATION" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="USA" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                        <Border Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="14" Padding="14" Margin="0,0,12,0">
                                            <StackPanel HorizontalAlignment="Center">
                                            <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,0,10" ClipToBounds="True">
                                                <Image Source="Assets/logo_2026.png" Stretch="UniformToFill"/>
                                            </Border>
                                                <TextBlock Text="HOST NATION" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="MEXICO" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="14" Padding="14" Margin="0,0,12,0">
                                            <StackPanel HorizontalAlignment="Center">
                                            <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,0,10" ClipToBounds="True">
                                                <Image Source="Assets/logo_2026.png" Stretch="UniformToFill"/>
                                            </Border>
                                                <TextBlock Text="HOST NATION" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="CANADA" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource Surface2}" CornerRadius="14" Padding="14" Margin="0,0,12,0">
                                            <StackPanel HorizontalAlignment="Center">
                                            <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,0,10" ClipToBounds="True">
                                                <Image Source="Assets/logo_2026.png" Stretch="UniformToFill"/>
                                            </Border>
                                                <TextBlock Text="REIGNING CHAMPION" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="ARGENTINA" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource Surface2}" CornerRadius="14" Padding="14" Margin="0,0,12,0">
                                            <StackPanel HorizontalAlignment="Center">
                                            <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,0,10" ClipToBounds="True">
                                                    <Image Source="Assets/logo_2026.png" Stretch="UniformToFill"/>
                                            </Border>
                                                <TextBlock Text="QUALIFIED" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="FRANCE" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource Surface2}" CornerRadius="14" Padding="14">
                                            <StackPanel HorizontalAlignment="Center">
                                            <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,0,10" ClipToBounds="True">
                                                    <Image Source="Assets/logo_2026.png" Stretch="UniformToFill"/>
                                            </Border>
                                                <TextBlock Text="QUALIFIED" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="BRAZIL" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Featured Venue"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="0" Margin="0,14,0,0" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="160"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Background="#23202C" CornerRadius="12,12,0,0" ClipToBounds="True">
                                                <Image Source="Assets/groups_stage.png" Stretch="UniformToFill" Opacity="0.95"/>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="14">
                                                <TextBlock Text="Los Angeles, USA | Capacity: 70,240" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Venue Tour" Foreground="{DynamicResource Accent3}" Margin="0,8,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Live Announcement" Foreground="{DynamicResource Accent2}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="Opening ceremony reveal set for Mexico City" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="The iconic Azteca Stadium will host the inaugural match of the 2026 tournament." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Surface3}" CornerRadius="12" Padding="0" Margin="0,10,0,0" Height="110" ClipToBounds="True">
                                        <Image Source="Assets/team_roster.png" Stretch="UniformToFill"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Countries -->
                    <Grid x:Name="PagePaises" Grid.Row="2" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Search countries" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtSearchCountry" Grid.Column="0" Margin="0,0,12,0" Height="38"/>
