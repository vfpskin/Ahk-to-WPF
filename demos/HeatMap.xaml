<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heat Map"
        Height="560"
        Width="700"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D0D1A" Offset="0"/>
            <GradientStop Color="#0A1628" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="ActionBtn_Style" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="TabCtrl_Style" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="TabItem_Style" TargetType="TabItem">
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="16,6"/>
        </Style>
    </Window.Resources>

    <Grid>

        <TextBlock Text="H E A T M A P"
                   Foreground="#AAAACC" FontSize="13" FontFamily="Consolas"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,16,0,0"/>

        <Button x:Name="CloseBtn" Content="X"
                Foreground="White" Background="#33FFFFFF" BorderBrush="#44FFFFFF"
                Width="28" Height="28" FontSize="13"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"/>

