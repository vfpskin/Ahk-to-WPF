<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MsgBox Showcase"
        Width="640" Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Surface" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#888888"/>
        <SolidColorBrush x:Key="Border" Color="#404040"/>
        <SolidColorBrush x:Key="Accent" Color="#5B9BD5"/>
        <SolidColorBrush x:Key="AccentHover" Color="#4A87C0"/>
        <SolidColorBrush x:Key="Surface2" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="Danger" Color="#E74C3C"/>
        <SolidColorBrush x:Key="ColorSuccess" Color="#A5DC86"/>
        <SolidColorBrush x:Key="ColorError" Color="#F27474"/>
        <SolidColorBrush x:Key="ColorWarning" Color="#F8BB86"/>
        <SolidColorBrush x:Key="ColorInfo" Color="#3FC3EE"/>
        <SolidColorBrush x:Key="ColorQuestion" Color="#87ADBD"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Surface}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Danger}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="20" CornerRadius="15" Background="{DynamicResource Surface}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>

            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Height="40" Background="Transparent"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblTitle" Text="MsgBox Showcase"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Button x:Name="BtnTheme" Width="70" Height="28" Content="Theme" FontSize="12" Padding="0" Margin="0,0,8,0"
                                    Background="{DynamicResource Surface2}" Foreground="{DynamicResource TextSecondary}"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="BtnClose" Width="30" Height="30" Content="&#x2715;" FontSize="14" BorderThickness="0" Padding="0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,14,0,20" HorizontalAlignment="Center">
                    <TextBlock Text="Click a button to test ui.Msgbox()" Foreground="{DynamicResource TextSecondary}" FontSize="15" HorizontalAlignment="Center"/>
                    <TextBlock Text="The modal dialog inherits the current theme." Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                    <Button x:Name="BtnAlertSuccess" Content="Success" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background><SolidColorBrush Color="#A5DC86"/></Button.Background>
                    </Button>
                    <Button x:Name="BtnAlertError" Content="Error" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background><SolidColorBrush Color="#F27474"/></Button.Background>
                    </Button>
                    <Button x:Name="BtnAlertWarning" Content="Warning" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background><SolidColorBrush Color="#F8BB86"/></Button.Background>
                    </Button>
                    <Button x:Name="BtnAlertInfo" Content="Info" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background><SolidColorBrush Color="#3FC3EE"/></Button.Background>
                    </Button>
                    <Button x:Name="BtnAlertQuestion" Content="Question" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background><SolidColorBrush Color="#87ADBD"/></Button.Background>
                    </Button>
                    <Button x:Name="BtnInputBox" Content="Input Box" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background><SolidColorBrush Color="#87ADBD"/></Button.Background>
                    </Button>
                    <Button x:Name="BtnAlert3Btns" Content="3 Buttons" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background><SolidColorBrush Color="#A569BD"/></Button.Background>
                    </Button>
                    <Button x:Name="BtnAlert4Btns" Content="4 Buttons" Width="150" Height="60" Margin="15" BorderThickness="0" Foreground="White">
                        <Button.Background><SolidColorBrush Color="#48C9B0"/></Button.Background>
                    </Button>
                </WrapPanel>

                <Border Grid.Row="3" Background="{DynamicResource WindowBg}" CornerRadius="8" Padding="14,10" MinHeight="50">
                    <TextBlock x:Name="LblResult" Text="Result: --"
                               Foreground="{DynamicResource TextSecondary}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
