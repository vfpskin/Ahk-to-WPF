<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:AhkControls;assembly=WPF_Runner"
        Background="#0F1A2A" WindowState="Normal"
        WindowStyle="None" AllowsTransparency="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="8,8,0,0">
      <Button Name="BtnClose" Content="X" Width="30" Height="26"
              Background="#C0392B" Foreground="White" FontWeight="Bold"
              BorderThickness="0" DockPanel.Dock="Right" Margin="0,0,8,0"/>
      <TextBlock Text="OCR Demo (Tesseract)" FontSize="18"
                 FontWeight="Bold" Foreground="#DCEFFF" VerticalAlignment="Center"/>
    </DockPanel>

    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="8,0,8,4">
      <TextBlock Text="Image file path:" Foreground="#8AB4CC" FontSize="11" Margin="0,0,0,2"/>
      <TextBox Name="ImagePath" Text="" Height="24" FontSize="11"
               Background="#1A2A3A" Foreground="#DCEFFF" BorderBrush="#2A4A6A"/>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <Button Name="BtnBrowse" Content="Browse" Width="100" Height="28" Margin="0,0,8,0"/>
        <Button Name="BtnOcr" Content="Run OCR" Width="100" Height="28" Margin="0,0,8,0"/>
        <Button Name="BtnClear" Content="Clear" Width="80" Height="28"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,4">
      <TextBlock Text="Lang:" Foreground="#8AB4CC" FontSize="11"
                 VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox Name="LangSelector" Width="160" Height="26" FontSize="11"
                Background="#1A2A3A" Foreground="#DCEFFF" BorderBrush="#2A4A6A"
                SelectedIndex="0">
        <ComboBoxItem Content="English" Tag="eng"/>
        <ComboBoxItem Content="Spanish" Tag="spa"/>
        <ComboBoxItem Content="English + Spanish" Tag="eng+spa"/>
        <ComboBoxItem Content="Spanish + English" Tag="spa+eng"/>
      </ComboBox>
    </StackPanel>

    <TextBlock Grid.Row="3" Text="OCR Result:" Foreground="#8AB4CC"
               FontSize="11" Margin="8,0,0,2"/>

    <local:OcrControl Grid.Row="4" Name="OcrView" Margin="8,0,8,8"/>

    <Button Grid.Row="5" Name="BtnTranslate" Content="Translate to Spanish"
            Width="200" Height="32" Margin="8" IsEnabled="False"/>
  </Grid>
</Window>
